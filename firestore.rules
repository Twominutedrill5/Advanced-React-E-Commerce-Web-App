rules_version = '2';

// Paste these into Firebase console → Firestore Database → Rules → Publish.
//
// Firestore starts in either test mode (open to everyone, expires in 30 days)
// or locked mode (closed to everyone). Neither is right for this app, so these
// rules say what it actually needs.
service cloud.firestore {
  match /databases/{database}/documents {

    // A user can only read or write their own profile document.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Products are public to read — anyone can browse the catalog — but only a
    // signed-in user can change them.
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Orders belong to whoever placed them. The create rule checks that the
    // userId on the incoming document matches the person writing it, so nobody
    // can file an order under someone else's account. Orders are never edited
    // or deleted once placed.
    match /orders/{orderId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
