# Copy this file to .env.local and paste in the values from your own Firebase
# project: Firebase console → Project settings → General → Your apps → SDK setup.
# .env.local is git-ignored, so your keys stay out of the repository.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional — only used by scripts/seedProducts.mjs so it can sign in before
# writing. Use an account you registered in the app.
SEED_EMAIL=
SEED_PASSWORD=
